# Copy to .env and fill in. Never commit .env.
AWS_PROFILE=madhavmain
AWS_REGION=ap-southeast-1

# --- image build (scripts/upload-and-create-image.sh) ---
S3_BUCKET=                      # existing bucket in the same region, e.g. my-mvm-demo-artifacts
S3_KEY=grader-image.zip
IMAGE_NAME=grader-image
# Verified with `aws lambda-microvms list-managed-microvm-images --region ap-southeast-1`
BASE_IMAGE_ARN=arn:aws:lambda:ap-southeast-1:aws:microvm-image:al2023-1
BUILD_ROLE_ARN=                 # output of scripts/create-roles.md step (role from iam/image-build-role.json)
IMAGE_MEMORY_MIB=1024

# --- grader (CLI + Lambda) ---
GRADER_IMAGE_ARN=               # imageArn printed by create-microvm-image
# Leave empty to use the managed ALL_INGRESS connector for the region.
INGRESS_CONNECTORS=
# MUST stay empty: no egress connector = no outbound access. Verify with payloads/exfil.py.
EGRESS_CONNECTORS=

# --- optional: Function URL (after `cdk deploy`) ---
GRADER_URL=
DEMO_SECRET=                    # long random string; also passed to cdk deploy

# --- recording helpers ---
PAUSE_MS=800
